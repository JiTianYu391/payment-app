{
  "name": "spacepay",
  "version": "4.0.0",
  "description": "SpacePay — 支付与资金管理（虚拟资金、模拟出款，不接入真实支付渠道）",
  "main": "app.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.2.0",
    "nodemailer": "^6.9.16"
  }
}
