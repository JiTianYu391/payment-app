# SpacePay 环境变量模板（在部署平台控制台填写，不要提交真实值到 Git）
PORT=3000
SESSION_SECRET=请改成随机长字符串至少32字符
# 二次确认令牌签名密钥；不填时使用 SESSION_SECRET
# CONFIRM_SECRET=

# 数据库：默认自动识别 /data/app.db（SQLite）；强制 JSON 后端可填 /data/app.json 或 DB_BACKEND=json
# DATABASE_PATH=/data/app.db
# DB_BACKEND=

# 演示模式：未配置真实邮件通道时，验证码只写入应用内收件箱
DEMO_MODE=true

# 真实邮件通道（优先级：SMTP > Webhook > 应用内收件箱）
# QQ 邮箱：smtp.qq.com:465（SSL），MAIL_SMTP_PASS 填「授权码」而不是登录密码
# MAIL_SMTP_HOST=smtp.qq.com
# MAIL_SMTP_PORT=465
# MAIL_SMTP_SECURE=true
# MAIL_SMTP_USER=123456789@qq.com
# MAIL_SMTP_PASS=your-smtp-authorization-code
# MAIL_FROM=SpacePay <123456789@qq.com>
# 或使用 HTTP Webhook：POST {to, template, purpose, code} 到该地址（5 秒超时，5xx/429 重试 2 次）
# MAIL_WEBHOOK_URL=
# MAIL_TIMEOUT_MS=5000
# 注意：配置了 SMTP 或 Webhook 后，/api/demo-inbox 自动关闭，避免凭邮箱读取验证码

# 管理员引导：这些邮箱登录/注册时自动成为管理员（逗号分隔）。其他角色由管理员在后台分配
ADMIN_EMAILS=

# 只允许这些来源跨域访问（逗号分隔）；留空表示不开放跨域
CORS_ORIGIN=http://localhost:3000
WELCOME_BONUS_CENTS=5000
TOPUP_MAX_CENTS=50000
WITHDRAW_MAX_CENTS=50000

# 提现限额（每用户，默认每日 3 笔 / $1,000，每月 10 笔 / $5,000）
# WITHDRAW_DAILY_COUNT=3
# WITHDRAW_DAILY_MAX_CENTS=100000
# WITHDRAW_MONTHLY_COUNT=10
# WITHDRAW_MONTHLY_MAX_CENTS=500000

# 商户开放平台（API 每分钟每个 Key 的请求上限）
# MERCHANT_RATE_LIMIT=120
# 对外站点地址，用于生成结账链接与 Webhook 文档示例
# PUBLIC_BASE_URL=https://your-domain

# 运行参数
# LOG_LEVEL=info            # debug | info | warn | error | silent
# REQUEST_TIMEOUT_MS=15000
# RATE_LIMIT_MAX=300        # 每 IP 每 15 分钟 /api 请求数
# AUTH_RATE_LIMIT_MAX=50    # 每 IP 每 15 分钟 /api/auth 请求数
# METRICS_TOKEN=            # 非空时，/metrics 需要 Bearer 该令牌
