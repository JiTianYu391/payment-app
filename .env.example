# 支付管理软件 — FadeHost 适配版环境变量模板
# 在 FadeHost 控制台 App → Environment variables 里填写，不要提交到 Git。
PORT=3000
SESSION_SECRET=请改成随机长字符串至少32字符
# 数据库路径：FadeHost 持久盘，默认自动识别 /data/app.json，不用填也行
DATABASE_PATH=/data/app.json
# DB_BACKEND=json
DEMO_MODE=true
CORS_ORIGIN=http://localhost:3000
WELCOME_BONUS_CENTS=5000
TOPUP_MAX_CENTS=50000
