# 支付管理 + 投资演示 v2 环境变量模板（FadeHost 控制台填写，不要提交到 Git）
PORT=3000
SESSION_SECRET=请改成随机长字符串至少32字符
# 数据库：默认自动识别 /data/app.db（SQLite）；想强制 JSON 后端可填 /data/app.json 或 DB_BACKEND=json
# DATABASE_PATH=/data/app.db
# DB_BACKEND=
DEMO_MODE=true
CORS_ORIGIN=http://localhost:3000
WELCOME_BONUS_CENTS=5000
TOPUP_MAX_CENTS=50000
