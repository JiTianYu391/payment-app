# 支付管理软件 — PandaStack Apps 适配版环境变量模板
# 在 PandaStack 控制台 Apps → 你的 App → Environment variables 里逐项填写，
# 不要把 .env 提交到 Git 仓库（.gitignore 已排除 .env）。
# 本地开发时复制为 .env 即可：cp .env.example .env

# 应用监听端口：PandaStack 平台自动注入 $PORT（默认 3000），本地开发填 3000
PORT=3000
# 会话密钥：部署时务必改成随机长字符串（至少 32 字符），不要用默认值
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<redacted>
# 数据库文件路径（双后端逻辑，见 src/db.js）
# - 推荐（已在控制台 Volumes 页创建 1 GiB 卷并挂载到 /workspace/data 后）：
DATABASE_PATH=/workspace/data/app.json
# - 未挂载卷时也可以用项目内相对路径 ./data/app.json，但注意：
#   PandaStack 每次部署都是全新机器、休眠会释放沙箱，官方文档说明休眠后
#   只保留部署时 baked 的产物，运行时写在仓库目录里的数据可能丢失，
#   所以正式部署务必用卷（见 README-pandastack.md 第 5 节）。
# - 想用 SQLite：改成 /workspace/data/app.db（需要 Node >= 22.5，.nvmrc 已锁定 22）
# - 强制指定后端（一般不用填）：DB_BACKEND=json
# DB_BACKEND=json
# 演示模式：true 时验证码显示在应用内演示邮箱收件箱，不发真实邮件
DEMO_MODE=true
# 允许的前端来源（部署后改成你的 App 域名，例如 https://jitianyu391.<suffix>/）
CORS_ORIGIN=http://localhost:3000
# 新用户体验金（单位：分，5000 = $50.00，不可提现）
WELCOME_BONUS_CENTS=5000
# 演示充值单次上限（单位：分，50000 = $500）
TOPUP_MAX_CENTS=50000
