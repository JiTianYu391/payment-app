# SpacePay 环境变量模板（在部署平台控制台填写，不要提交真实值到 Git）
PORT=3000
SESSION_SECRET=请改成随机长字符串至少32字符
# 二次确认令牌签名密钥；不填时使用 SESSION_SECRET
# CONFIRM_SECRET=

# 数据库：默认自动识别 /data/app.db（SQLite）；强制 JSON 后端可填 /data/app.json 或 DB_BACKEND=json
# DATABASE_PATH=/data/app.db
# DB_BACKEND=

# 演示模式：验证码显示在应用内演示收件箱，不发真实邮件
DEMO_MODE=true
# 非演示模式下的验证码投递：POST {to, template, purpose, code} 到该地址（5 秒超时，5xx/429 重试 2 次）
# MAIL_WEBHOOK_URL=
# MAIL_TIMEOUT_MS=5000

# 管理员引导：这些邮箱登录/注册时自动成为管理员（逗号分隔）。其他角色由管理员在后台分配
ADMIN_EMAILS=

CORS_ORIGIN=http://localhost:3000
WELCOME_BONUS_CENTS=5000
TOPUP_MAX_CENTS=50000
WITHDRAW_MAX_CENTS=50000

# 运行参数
# LOG_LEVEL=info            # debug | info | warn | error | silent
# REQUEST_TIMEOUT_MS=15000
# RATE_LIMIT_MAX=300        # 每 IP 每 15 分钟 /api 请求数
# AUTH_RATE_LIMIT_MAX=50    # 每 IP 每 15 分钟 /api/auth 请求数
